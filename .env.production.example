# ---- Laravel API: production values (copy the names, never commit real secrets) -------
APP_NAME=AURUM
APP_ENV=production
APP_DEBUG=false                  # never true in production: it prints stack traces and settings
APP_URL=https://api.your-domain.com
APP_KEY=                         # php artisan key:generate --show

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database: use a server in the SAME region as the API (a 500 ms round trip made login take 13 s).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=               # path to the provider's CA certificate when the DB requires TLS

# The API does not use browser sessions; keep these cheap.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum: tokens expire after this many minutes (default 7 days). The website's cookie uses the same lifetime.
SANCTUM_EXPIRATION=10080

# Browsers talk to the website, not to this API, so CORS only needs the site's own address
# (comma separated). Needed for the server-side calls of other tools you may add.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# IMPORTANT: addresses of the servers that call this API (the Next.js server / hosting platform egress IPs).
# Only these may set X-Forwarded-For, so rate limits (login, inquiries) apply per visitor.
TRUSTED_PROXIES=203.0.113.10

CLOUDINARY_URL=                  # cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (rotate the one that was shared in chat!)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
